#include <iostream>
#include <string>
using namespace std;

int main() {
    string data;

    cout << "Enter 4-bit data: ";
    cin >> data;

    if (data.length() != 4) {
        cout << "Invalid input! Enter exactly 4 bits.\n";
        return 0;
    }

    int h[8];

    h[3] = data[0] - '0';
    h[5] = data[1] - '0';
    h[6] = data[2] - '0';
    h[7] = data[3] - '0';

    h[1] = h[3] ^ h[5] ^ h[7];
    h[2] = h[3] ^ h[6] ^ h[7];
    h[4] = h[5] ^ h[6] ^ h[7];

    cout << "\nGenerated Hamming Code: ";
    for (int i = 1; i <= 7; i++)
        cout << h[i];
    cout << endl;

    string received;
    cout << "\nEnter received 7-bit code: ";
    cin >> received;

    if (received.length() != 7) {
        cout << "Invalid input! Enter exactly 7 bits.\n";
        return 0;
    }

    int r[8];
    for (int i = 1; i <= 7; i++)
        r[i] = received[i - 1] - '0';

    int s1 = r[1] ^ r[3] ^ r[5] ^ r[7];
    int s2 = r[2] ^ r[3] ^ r[6] ^ r[7];
    int s4 = r[4] ^ r[5] ^ r[6] ^ r[7];

    int errorPos = s4 * 4 + s2 * 2 + s1;

    if (errorPos == 0) {
        cout << "\nNo error detected.\n";
    } else {
        cout << "\nError detected at position: " << errorPos << endl;

        r[errorPos] = 1 - r[errorPos];

        cout << "Corrected Hamming Code: ";
        for (int i = 1; i <= 7; i++)
            cout << r[i];
        cout << endl;
    }

    return 0;
}
